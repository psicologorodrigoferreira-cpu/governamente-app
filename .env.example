# Copie para .env (no seu computador) ou cadastre no Expo em "Environment variables".
# Nunca coloque aqui a service_role do Supabase nem senhas: estas chaves são públicas por natureza.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys (chaves públicas de cada loja)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Link do checkout da Hubla para a assinatura mensal do app (opcional)
EXPO_PUBLIC_LINK_HUBLA_APP=
